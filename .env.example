# =====================================================================
# HEMOGLYPH - OPTIONAL ENVIRONMENT CONFIGURATION
# =====================================================================

# --- Vision OCR for Laboratory Image/PDF Extraction ---
# You can enter your Groq API Key (free at https://console.groq.com)
# or OpenAI API Key here, or directly in Settings inside Hemoglyph!
OCR_BACKEND=vision
OCR_API_KEY=
OCR_BASE_URL=https://api.groq.com/openai/v1
OCR_VISION_MODEL=llama-3.2-11b-vision-preview

# --- Local AI Chatbot Configuration ---
# Runs 100% offline via local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
HEMOGLYPH_CHAT_MODEL=qwen2.5:1.5b

# --- Sentinel License & Telemetry Platform ---
# Address of your administrator dashboard (on your laptop, Cloudflare tunnel, or VPS)
HEMOGLYPH_SENTINEL_URL=http://localhost:8090
